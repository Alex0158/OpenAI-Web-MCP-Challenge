#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
relay_path="$script_dir/../src/relay/codex-app-tools-relay.mjs"

if [ -z "${CODEX_MCP_NODE_PATH:-}" ] || [ ! -x "$CODEX_MCP_NODE_PATH" ]; then
  printf '%s\n' 'The signed bundled CODEX_MCP_NODE_PATH is required.' >&2
  exit 127
fi

exec "$CODEX_MCP_NODE_PATH" "$relay_path"
