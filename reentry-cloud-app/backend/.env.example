# Copy to .env.local in this backend package for local development.
# Anything marked REQUIRED IN PRODUCTION is enforced by the zod schema in
# src/config/config.ts — the process refuses to start without it.

# Server
PORT=4000
NODE_ENV=development

# Database — use either DATABASE_URL or the old Cloud Receiver runtime name.
# For Supabase, CLOUD_RECEIVER_RUNTIME_DATABASE_URL should be the session-mode
# pooler URL (port 5432). DIRECT_URL is used by Prisma migrations when set.
DATABASE_URL=postgresql://postgres:password@localhost:5432/app
CLOUD_RECEIVER_RUNTIME_DATABASE_URL=
DIRECT_URL=

# Auth — REQUIRED IN PRODUCTION (min 32 characters there; a dev default is
# substituted locally). Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Session cookie lifetime
SESSION_DAYS=7

# Frontend origin — REQUIRED IN PRODUCTION, CORS depends on it
FRONTEND_URL=http://localhost:3000

# Public origin of this Cloud Receiver. Used when creating browser-facing URLs.
RECEIVER_PUBLIC_URL=http://localhost:4000

# Cookie scope. Leave UNSET locally: localhost:3000 and localhost:4000 are the
# same host, so cookies already work. In production the frontend and API are on
# different subdomains, so this must be the shared parent domain or the browser
# will never send the cookie back — e.g. .example.com
# COOKIE_DOMAIN=.example.com

# Reserved Cloud Receiver names. They are intentionally not required by this
# simple auth slice and are not read by the authentication logic yet.
# CLOUD_RECEIVER_CONNECTOR_TOKEN_SECRET=
# CLOUD_RECEIVER_VERIFICATION_ORIGIN=
# CLOUD_RECEIVER_GRANT_CONTROL_TOKEN=
