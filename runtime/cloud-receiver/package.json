{
  "name": "@webmcp-challenge/cloud-receiver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loopback-only Cloud Receiver shell, Re-entry Cloud console, and Connector preview.",
  "exports": {
    ".": "./src/index.mjs",
    "./service": "./src/cloud-receiver-service.mjs",
    "./account-store": "./src/account-store.mjs",
    "./dashboard-control": "./src/dashboard-control.mjs",
    "./host-key-control": "./src/host-key-control.mjs",
    "./consent-control": "./src/consent-control.mjs",
    "./local-preview-composition": "./src/local-preview-composition.mjs",
    "./product-preview-composition": "./src/product-preview-composition.mjs",
    "./sqlite-composition": "./src/sqlite-composition.mjs"
  },
  "scripts": {
    "start": "node src/product-preview-main.mjs",
    "start:service": "node src/main.mjs",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check:syntax && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
