generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model RuntimeStoreSnapshot {
  storeName String   @id @map("store_name")
  payload   Bytes
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reentry_runtime_store_snapshots")
}

model Account {
  account_id        String @id
  identity          String @unique
  credential_salt   String
  credential_digest String
  created_at        String

  @@index([created_at])
  @@map("reentry_accounts")
}

model Organization {
  organization_id String @id
  account_id      String
  name            String
  created_at      String

  @@index([account_id, created_at])
  @@map("reentry_organizations")
}

model ApiKey {
  api_key_id      String  @id
  organization_id String
  key_digest      String  @unique
  key_prefix      String
  created_at      String
  revoked_at      String?

  @@index([organization_id, created_at])
  @@map("reentry_api_keys")
}

model Session {
  session_id   String @id
  account_id   String
  token_digest String @unique
  created_at   String
  expires_at   String

  @@index([expires_at])
  @@map("reentry_sessions")
}

model PairingSession {
  pairing_id              String  @id
  organization_id         String
  host_subject_ref_digest String
  subject_id              String
  delivery_target_id      String
  connector_id            String
  device_code_digest      String  @unique
  user_code_digest        String  @unique
  connector_token_digest  String  @unique
  status                  String
  created_at              String
  expires_at              String
  claimed_at              String?
  approved_at             String?
  consumed_at             String?

  @@index([status, expires_at])
  @@index([organization_id, host_subject_ref_digest, created_at])
  @@map("cloud_pairing_sessions")
}

model CloudConnector {
  connector_id           String  @id
  organization_id        String
  subject_id             String
  delivery_target_id     String  @unique
  connector_token_digest String  @unique
  created_at             String
  expires_at             String
  revoked_at             String?

  @@map("cloud_connectors")
}

model HostSubjectLink {
  organization_id         String
  host_subject_ref_digest String
  subject_id              String @unique
  delivery_target_id      String @unique
  connector_id            String @unique
  created_at              String

  @@id([organization_id, host_subject_ref_digest])
  @@map("cloud_host_subject_links")
}

model HostSigningKey {
  organization_id String
  host_id         String
  issuer_origin   String
  key_id          String
  public_key_pem  String
  created_at      String

  @@id([organization_id, host_id])
  @@unique([organization_id, issuer_origin, key_id])
  @@map("cloud_host_signing_keys")
}

model LegacyConsentSession {
  consent_session_id      String  @id
  organization_id         String
  challenge_id            String  @unique
  host_subject_ref_digest String
  subject_id              String
  delivery_target_id      String
  consent_token_digest    String  @unique
  decision_id             String  @unique
  status                  String
  created_at              String
  expires_at              String
  decision_action         String?
  decided_at              String?

  @@index([organization_id, host_subject_ref_digest, created_at])
  @@map("cloud_consent_sessions")
}

model DeviceAuthorization {
  authorization_id       String  @id
  device_code_digest     String  @unique
  browser_token_digest   String  @unique
  connector_id           String  @unique
  connector_token_digest String  @unique
  subject_id             String  @unique
  delivery_target_id     String  @unique
  device_name            String
  account_id             String?
  status                 String
  created_at             String
  expires_at             String
  decided_at             String?
  consumed_at            String?

  @@index([status, expires_at])
  @@map("product_device_authorizations")
}

model AccountConnector {
  connector_id           String  @id
  account_id             String
  device_name            String
  subject_id             String
  delivery_target_id     String  @unique
  connector_token_digest String  @unique
  created_at             String
  expires_at             String
  revoked_at             String?

  @@index([account_id, created_at, connector_id])
  @@map("product_account_connectors")
}

model AccountPairingRequest {
  pairing_id             String  @id
  account_id             String
  pairing_code_digest    String  @unique
  connector_id           String  @unique
  connector_token_digest String  @unique
  subject_id             String  @unique
  delivery_target_id     String  @unique
  device_name            String?
  created_at             String
  expires_at             String
  consumed_at            String?

  @@index([expires_at, consumed_at])
  @@map("product_account_pairing_requests")
}

model AccountHostSubjectLink {
  organization_id         String
  host_subject_ref_digest String
  account_id              String
  subject_id              String
  delivery_target_id      String
  connector_id            String
  created_at              String

  @@id([organization_id, host_subject_ref_digest])
  @@index([connector_id, created_at])
  @@map("product_account_host_subject_links")
}

model AccountConsentSession {
  consent_session_id      String  @id
  organization_id         String
  challenge_id            String  @unique
  host_subject_ref_digest String
  consent_token_digest    String  @unique
  decision_id             String  @unique
  status                  String
  account_id              String?
  connector_id            String?
  subject_id              String?
  delivery_target_id      String?
  created_at              String
  expires_at              String
  decision_action         String?
  decided_at              String?
  binding_json            String?

  @@index([organization_id, created_at, consent_session_id])
  @@map("product_account_consent_sessions")
}

model Challenge {
  challenge_id         String  @id
  manifest_id          String  @unique
  manifest_json        String
  expected_origin      String
  effective_expires_at String
  status               String
  decision_id          String? @unique
  decision_action      String?
  subject_id           String?
  created_at           String
  decided_at           String?

  @@map("receiver_challenges")
}

model Grant {
  grant_id           String  @id
  challenge_id       String  @unique
  manifest_id        String
  binding_id         String  @unique
  subject_id         String
  delivery_target_id String
  correlation_id     String
  issuer_origin      String
  workflow_type      String
  workflow_id        String
  event_type         String
  canonical_url      String
  expires_at         String
  human_boundary     String
  runs_remaining     Int
  revoked_at         String?
  receipt_json       String
  created_at         String

  @@map("receiver_grants")
}

model Event {
  event_id        String @id
  grant_id        String @unique
  canonical_body  String
  acceptance_json String
  received_at     String

  @@map("receiver_events")
}

model Delivery {
  delivery_id        String @id
  event_id           String @unique
  grant_id           String @unique
  delivery_target_id String
  status             String
  created_at         String

  @@index([status, delivery_target_id, created_at])
  @@index([delivery_target_id, created_at, delivery_id])
  @@map("receiver_deliveries")
}

model DeliveryState {
  delivery_id                String  @id
  status                     String
  maximum_attempts           Int
  current_attempt            Int
  current_connector_id       String?
  current_lease_token_digest String? @unique
  leased_at                  String?
  lease_expires_at           String?
  effect_id                  String? @unique
  effect_attestation_json    String?
  acknowledged_at            String?
  terminal_reason            String?
  updated_at                 String

  @@index([status, lease_expires_at, delivery_id])
  @@map("receiver_delivery_states")
}

model DeliveryAttempt {
  delivery_id        String
  attempt            Int
  connector_id       String
  lease_token_digest String @unique
  leased_at          String
  lease_expires_at   String

  @@id([delivery_id, attempt])
  @@map("receiver_delivery_attempts")
}
