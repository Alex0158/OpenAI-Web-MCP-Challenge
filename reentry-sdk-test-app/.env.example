# The exact browser origin where this test app runs.
HOST_ORIGIN=http://localhost:3000

# Active Re-entry Cloud Receiver v2 origin from the developer dashboard/environment.
RECEIVER_ORIGIN=https://your-reentry-receiver.example

# Keep all three values server-side. Do not expose them as public browser variables.
REENTRY_KEY_ID=host_key_reentry_sdk_test_app
REENTRY_PRIVATE_KEY=replace-with-ed25519-pkcs8-pem-private-key
REENTRY_ORGANIZATION_API_KEY=re_org_replace-with-your-dashboard-api-key
